# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
AVANAN_CLIENT_ID=
AVANAN_CLIENT_SECRET=
# Region is not a credential. Gateway requests can send X-Avanan-Region.
# us (default), eu, ca, ap, euw2, aps1. One API key per region.
AVANAN_REGION=us

# stdio (default) or http
MCP_TRANSPORT=stdio

# Bind address when MCP_TRANSPORT=http. When MCP_HTTP_HOST is unset, the
# HTTP server binds 127.0.0.1. The container image sets 0.0.0.0 and requires
# CONDUIT_S2S_SECRET. A configured secret honors this value.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

# Required to start the HTTP transport. Leave this empty here.
# Generate a value with: openssl rand -hex 32
# The process exits if this is empty or a known placeholder (changeme, secret,
# your-s2s-secret, and the other example strings), so a copied placeholder
# cannot forge X-Gateway-S2S. docker compose will not start when it is unset
# or empty. Never commit a real secret. The value is never logged.
# Local development only: MCP_ALLOW_INSECURE_DEV=1 starts HTTP without this
# secret, logs a warning, skips X-Gateway-S2S, and binds 127.0.0.1 only.
# A non-loopback MCP_HTTP_HOST is ignored in that mode.
CONDUIT_S2S_SECRET=
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-Avanan-Client-Id and X-Avanan-Client-Secret headers; no env fallback).
# The container image and compose file set gateway. Stdio reads AVANAN_*.
# AUTH_MODE=env

LOG_LEVEL=info
